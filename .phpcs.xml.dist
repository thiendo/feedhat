<?xml version="1.0"?>
<ruleset name="Clarity Feedback">
	<description>WPCS ruleset for Clarity Feedback — run with `phpcs` (no extra flags needed) before every release, per CLAUDE.md mục 5/6.</description>

	<file>.</file>

	<!-- Third-party/vendored code and build output — not ours to fix. -->
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/dist/*</exclude-pattern>
	<exclude-pattern>*/assets/js/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>

	<rule ref="WordPress-Extra">
		<!--
			This project intentionally uses short internal file names
			(e.g. includes/core/class-license.php for
			Clarity_Feedback_License) rather than repeating the
			"Clarity_Feedback_" prefix in every filename — standard
			practice for plugins with a `Clarity_Feedback_` class prefix
			already implied by the folder. Only relaxes the "must match the
			FULL class name" check; the plain class-*.php / lowercase-
			hyphenated conventions are still enforced.
		-->
		<properties>
			<property name="strict_class_file_names" value="false"/>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="clarity-feedback"/>
			</property>
		</properties>
	</rule>
</ruleset>
